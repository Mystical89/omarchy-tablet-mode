+/* omarchy-tablet-mode: Hyprland sends no wl_output event on a rotation, and a
+ * bottom-left anchored panel gets no configure either, so the keyboard would
+ * keep its old size until it is hidden and shown by hand. A tiny invisible
+ * probe layer surface anchored to all four edges receives a configure on every
+ * change of the usable area (rotation included) — that is the signal. */
+static struct wl_surface *probe_surf = NULL;
+static struct zwlr_layer_surface_v1 *probe_layer = NULL;
+static uint32_t probe_w = 0, probe_h = 0;
+static bool rotation_pending = false;
+
+static void
+probe_configure(void *data, struct zwlr_layer_surface_v1 *ls, uint32_t serial,
+                uint32_t w, uint32_t h)
+{
+    zwlr_layer_surface_v1_ack_configure(ls, serial);
+    /* The probe is anchored left+right, so its width is the output's usable
+     * width: stable while this keyboard reserves a bottom strip (dock mode)
+     * and changes only when the output is rotated. A w/h ratio would flip on
+     * every hide/show in a narrow portrait screen and loop. */
+    if ((probe_w > 0) && (w != probe_w)) {
+        rotation_pending = true;
+    }
+    probe_w = w;
+    probe_h = h;
+}
+
+static void
+probe_closed(void *data, struct zwlr_layer_surface_v1 *ls)
+{
+    zwlr_layer_surface_v1_destroy(ls);
+    probe_layer = NULL;
+}
+
+static const struct zwlr_layer_surface_v1_listener probe_listener = {
+    .configure = probe_configure,
+    .closed = probe_closed,
+};
+
+static void
+probe_create(void)
+{
+    if (probe_surf || (!compositor) || (!layer_shell)) {
+        return;
+    }
+    probe_surf = wl_compositor_create_surface(compositor);
+    probe_layer = zwlr_layer_shell_v1_get_layer_surface(
+        layer_shell, probe_surf, target_output, layer, "wvkbd-probe");
+    zwlr_layer_surface_v1_set_anchor(probe_layer,
+                                     ZWLR_LAYER_SURFACE_V1_ANCHOR_TOP |
+                                     ZWLR_LAYER_SURFACE_V1_ANCHOR_LEFT |
+                                     ZWLR_LAYER_SURFACE_V1_ANCHOR_RIGHT);
+    zwlr_layer_surface_v1_set_size(probe_layer, 0, 1);
+    zwlr_layer_surface_v1_set_exclusive_zone(probe_layer, 0);
+    zwlr_layer_surface_v1_set_keyboard_interactivity(probe_layer, false);
+    zwlr_layer_surface_v1_add_listener(probe_layer, &probe_listener, NULL);
+    wl_surface_commit(probe_surf);
+}
