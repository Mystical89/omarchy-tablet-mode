+/* omarchy-tablet-mode: floating keyboard helpers ------------------------------- */
+
+static bool
+floating_on_handle(int32_t y)
+{
+    /* The handle is the strip at the very top of the panel. In docked mode it
+     * collapses to half height and only carries the toggle button. */
+    if (!float_enabled || keyboard.handle_h == 0 || y < 0) {
+        return false;
+    }
+    uint32_t hh = float_mode ? keyboard.handle_h : keyboard.handle_h / 2;
+    return (uint32_t)y < hh;
+}
+
+static void
+floating_apply_margins(void)
+{
+    if (!layer_surface || !float_enabled || !float_mode) {
+        return;
+    }
+    zwlr_layer_surface_v1_set_margin(layer_surface, 0, 0, margin_bottom,
+                                     margin_left);
+    wl_surface_commit(draw_surf.surf);
+}
+
+static void
+floating_begin_drag(int32_t x, int32_t y)
+{
+    if (!float_mode) {
+        return;
+    }
+    dragging = true;
+    drag_x = x;
+    drag_y = y;
+    drag_margin_left = margin_left;
+    drag_margin_bottom = margin_bottom;
+}
+
+static void
+floating_update_drag(int32_t x, int32_t y)
+{
+    if (!dragging) {
+        return;
+    }
+    int32_t dx = x - drag_x;
+    int32_t dy = y - drag_y;
+
+    int32_t max_left = (int32_t)available_width - (int32_t)float_w;
+    if (max_left < 0) {
+        max_left = 0;
+    }
+    int32_t new_left = drag_margin_left + dx;
+    if (new_left < 0) {
+        new_left = 0;
+    }
+    if (new_left > max_left) {
+        new_left = max_left;
+    }
+    margin_left = new_left;
+
+    /* Dragging up lifts the panel: the bottom margin grows. */
+    int32_t max_bottom = (int32_t)available_height - (int32_t)height;
+    if (max_bottom < 0) {
+        max_bottom = 0;
+    }
+    int32_t new_bottom = drag_margin_bottom - dy;
+    if (new_bottom < 0) {
+        new_bottom = 0;
+    }
+    if (new_bottom > max_bottom) {
+        new_bottom = max_bottom;
+    }
+    margin_bottom = new_bottom;
+
+    if (keyboard.debug) {
+        fprintf(stderr, "drag: margin_left=%d margin_bottom=%d\n", margin_left,
+                margin_bottom);
+    }
+    floating_apply_margins();
+}
+
+static void
+floating_end_drag(void)
+{
+    dragging = false;
+    float_state_save();
+}
+
+/* omarchy-tablet-mode: persisted per-orientation floating state. Portrait and
+ * landscape keep separate positions and modes: a panel parked in landscape is
+ * rarely where it should be on a narrow portrait screen, and vice versa. */
+static int
+float_ori_idx(void)
+{
+    return keyboard.landscape ? 1 : 0;
+}
+
+static void
+float_apply_state(void)
+{
+    int i = float_ori_idx();
+    float_mode = st_float[i];
+    margin_left = st_margin_left[i];
+    margin_bottom = st_margin_bottom[i];
+}
+
+static void
+float_clamp_margins(void)
+{
+    /* A position saved on a wide output can be off-screen on a narrow one
+     * (landscape -> portrait), so margins are clamped on every apply. */
+    int32_t max_left = (int32_t)available_width - (int32_t)float_w;
+    if (max_left < 0) {
+        max_left = 0;
+    }
+    if (margin_left > max_left) {
+        margin_left = max_left;
+    }
+    if (margin_left < 0) {
+        margin_left = 0;
+    }
+    int32_t max_bottom = (int32_t)available_height - (int32_t)height;
+    if (max_bottom < 0) {
+        max_bottom = 0;
+    }
+    if (margin_bottom > max_bottom) {
+        margin_bottom = max_bottom;
+    }
+    if (margin_bottom < 0) {
+        margin_bottom = 0;
+    }
+}
+
+static bool
+float_state_path(char *buf, size_t buflen)
+{
+    const char *env = getenv("WVKBD_FLOAT_STATE");
+    if (env) {
+        snprintf(buf, buflen, "%s", env);
+        return true;
+    }
+    const char *cache = getenv("XDG_CACHE_HOME");
+    if (cache) {
+        snprintf(buf, buflen, "%s/wvkbd-deskus-float.state", cache);
+        return true;
+    }
+    const char *home = getenv("HOME");
+    if (!home) {
+        return false;
+    }
+    snprintf(buf, buflen, "%s/.cache/wvkbd-deskus-float.state", home);
+    return true;
+}
+
+static void
+float_state_save(void)
+{
+    int i = float_ori_idx();
+    st_float[i] = float_mode;
+    st_margin_left[i] = margin_left;
+    st_margin_bottom[i] = margin_bottom;
+
+    char path[512];
+    if (!float_state_path(path, sizeof(path))) {
+        return;
+    }
+    FILE *f = fopen(path, "w");
+    if (!f) {
+        return;
+    }
+    fprintf(f, "portrait margin_left=%d margin_bottom=%d float=%d\n",
+            st_margin_left[0], st_margin_bottom[0], st_float[0] ? 1 : 0);
+    fprintf(f, "landscape margin_left=%d margin_bottom=%d float=%d\n",
+            st_margin_left[1], st_margin_bottom[1], st_float[1] ? 1 : 0);
+    fclose(f);
+}
+
+static void
+float_state_load(void)
+{
+    char path[512];
+    if (!float_state_path(path, sizeof(path))) {
+        return;
+    }
+    FILE *f = fopen(path, "r");
+    if (!f) {
+        return;
+    }
+    char tag[32];
+    int l, b, fl;
+    while (fscanf(f, "%31s margin_left=%d margin_bottom=%d float=%d",
+                  tag, &l, &b, &fl) == 4) {
+        int i = strcmp(tag, "portrait") == 0 ? 0 : 1;
+        st_margin_left[i] = l;
+        st_margin_bottom[i] = b;
+        st_float[i] = fl ? true : false;
+    }
+    fclose(f);
+}
+
+/* omarchy-tablet-mode: the right corner of the handle (or of the slim docked
+ * bar) is the width-mode toggle. Tapping it switches floating <-> full-width
+ * docked (exclusive zone on, windows are pushed aside instead of covered). */
+#define FLOAT_TOGGLE_W 56
+static bool
+floating_on_toggle_button(int32_t x)
+{
+    if (!float_enabled || keyboard.handle_h == 0 || x < 0) {
+        return false;
+    }
+    uint32_t btn_w = FLOAT_TOGGLE_W;
+    if (btn_w > keyboard.w / 3) {
+        btn_w = keyboard.w / 3;
+    }
+    return (uint32_t)x >= keyboard.w - btn_w;
+}
+
+static void
+floating_toggle_width(void)
+{
+    float_mode = !float_mode;
+    float_state_save();
+    hide();
+    show();
+}
+
+/* omarchy-tablet-mode: --debug-drag runs the same begin/update/end sequence the
+ * touch handler uses, so the margin maths and the layer-shell update can be
+ * verified without a finger on the screen. */
+static void
+floating_debug_drag(void)
+{
+    int32_t sx = 100, sy = 200, tx = 200, ty = 60;
+    fprintf(stderr, "debug-drag: start margins left=%d bottom=%d\n",
+            margin_left, margin_bottom);
+    floating_begin_drag(sx, sy);
+    floating_update_drag(tx, ty);
+    fprintf(stderr, "debug-drag: moved to left=%d bottom=%d\n", margin_left,
+            margin_bottom);
+    floating_end_drag();
+}
